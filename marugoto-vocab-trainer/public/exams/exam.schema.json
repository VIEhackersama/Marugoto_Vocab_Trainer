{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marugoto Exam JSON v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "sections"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/text"},
    "description": {"$ref": "#/$defs/content"},
    "instructions": {"$ref": "#/$defs/content"},
    "timeLimitMinutes": {"type": "integer", "minimum": 1, "maximum": 1440},
    "sections": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$", "not": {"enum": ["constructor", "prototype"]}},
    "text": {"type": "string", "minLength": 1, "maxLength": 200000, "pattern": "\\S"},
    "points": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 1},
    "content": {
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {"type": "array", "minItems": 1, "maxItems": 10000, "items": {
          "type": "object", "additionalProperties": false, "required": ["text"],
          "properties": {"text": {"$ref": "#/$defs/text"}, "reading": {"$ref": "#/$defs/text"}}
        }}
      ]
    },
    "section": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "questions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"},
        "instructions": {"$ref": "#/$defs/content"}, "passage": {"$ref": "#/$defs/content"},
        "questions": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"oneOf": [{"$ref": "#/$defs/choice"}, {"$ref": "#/$defs/fill"}, {"$ref": "#/$defs/essay"}]}}
      }
    },
    "choice": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "prompt", "explanation", "options", "correctOptionId"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "type": {"const": "single_choice"}, "prompt": {"$ref": "#/$defs/content"},
        "explanation": {"$ref": "#/$defs/content"}, "points": {"$ref": "#/$defs/points"}, "correctOptionId": {"$ref": "#/$defs/id"},
        "options": {"type": "array", "minItems": 2, "maxItems": 20, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "text"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/content"}}
        }}
      }
    },
    "fill": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "prompt", "explanation", "blanks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "type": {"const": "fill_blank"}, "prompt": {"$ref": "#/$defs/content"}, "explanation": {"$ref": "#/$defs/content"},
        "blanks": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "acceptedAnswers"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "acceptedAnswers": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/text"}}, "points": {"$ref": "#/$defs/points"}}
        }}
      }
    },
    "essay": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "prompt", "explanation", "modelAnswer"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "type": {"const": "essay"}, "prompt": {"$ref": "#/$defs/content"},
        "explanation": {"$ref": "#/$defs/content"}, "modelAnswer": {"$ref": "#/$defs/content"}
      }
    }
  },
  "$comment": "Backend additionally checks IDs, option references, one placeholder per blank, placeholders not split between tokens, no reading on blank tokens, and a maximum of 1000 questions across sections."
}
