# ==========================================
# Marugoto Vocab Trainer - Git Ignore Rules
# ==========================================

# --- Node / Frontend ---
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Environment variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Java & Maven ---
target/
backend/target/
*.class
*.jar
!backend/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.nar

# --- Application Data & SQLite Database ---
data/
backend/data/
**/data/
**/backend/data/
pdfs/
backend/pdfs/
**/pdfs/
**/backend/pdfs/
*.db
*.db.*
*.db-shm
*.db-wal
*.bak
trainer.db*

# --- IDEs & Code Editors ---
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath
.factorypath

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Logs & Temp ---
*.log
logs/
temp/
tmp/
